# ── Credentials ──────────────────────────────────────────────────────────────
# Copy .env.example → .env and fill in your values; never commit .env
ngnt-geiger-dockerized/.env

# ── Auto-provisioned device credentials (hashed, managed by Flask)
# Flask creates devices.conf on the first registration.
ngnt-geiger-dockerized/config/mosquitto/devices.conf
ngnt-geiger-dockerized/config/mosquitto/passwd.txt

# ── Mosquitto reload flag ────────────────────────────────────────────────────
ngnt-geiger-dockerized/config/mosquitto/.reload

# ── Runtime data ─────────────────────────────────────────────────────────────
ngnt-geiger-dockerized/data/
ngnt-geiger-dockerized/volumes/mariadb/*
!ngnt-geiger-dockerized/volumes/mariadb/.gitkeep

ngnt-geiger-dockerized/volumes/mosquitto/data/*
!ngnt-geiger-dockerized/volumes/mosquitto/data/.gitkeep

ngnt-geiger-dockerized/volumes/mosquitto/certs/*
!ngnt-geiger-dockerized/volumes/mosquitto/certs/.gitkeep


# ── Log files ────────────────────────────────────────────────────────────────
ngnt-geiger-dockerized/log/mosquitto/*.log
!ngnt-geiger-dockerized/log/mosquitto/.gitkeep

# ── Stale / duplicate runtime data ──────────────────────────────────────────
ngnt-geiger-dockerized/volumes/volumes/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
