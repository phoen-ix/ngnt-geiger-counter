# Resolve only versions published at least a day ago: a hijacked release is usually caught and
# pulled within hours. A fix that cannot wait: name its package in --min-release-age-exclude on
# that install.
# nosemgrep: package_managers.npm.npm-missing-minimum-release-age.npm-missing-minimum-release-age - owner decision 2026-11-01: 1 day for every npm project, not the rule's 7
min-release-age=1
